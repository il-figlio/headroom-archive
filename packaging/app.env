# App-specific release values, read by scripts/build.sh (zsh `source`) and by
# scripts/appconfig.py. Plain KEY=VALUE lines only: no quotes, spaces or shell
# expansion, so both readers agree. To reuse this release pipeline for another
# app, copy packaging/, VERSION, Resources/Info.plist.in and scripts/, then edit
# this file (and the Swift UpdatePolicy constants, which a check compares here).
APP_NAME=Headroom
EXECUTABLE=Headroom
BUNDLE_ID=org.headroom.app
MIN_MACOS=13.0
GITHUB_REPO=il-figlio/headroom
FEED_URL=https://raw.githubusercontent.com/il-figlio/headroom/main/appcast.xml
SPARKLE_PUBLIC_ED_KEY=P+pq45klNYA8nWSg8kk7+BK6gCbPVVWPSka0p6iEl9c=
SPARKLE_KEYCHAIN_ACCOUNT=org.headroom.app
NOTARY_PROFILE=headroom-notary
CASK_TOKEN=headroom
HOMEBREW_TAP=il-figlio/homebrew-tap
